# Port the API listens on. Render sets this itself.
PORT=
# "production" turns on the Secure flag for cookies.
NODE_ENV=
# Neon's pooled connection string, used by the running app.
DATABASE_URL=
# Neon's direct connection string, used by migrations and seeding.
DIRECT_URL=
# Signs the session cookie. At least 32 characters: openssl rand -base64 48
SESSION_SECRET=
# Classifies Tickets and writes Drafts. Without it the API still runs, new Tickets stay Unclassified, and Admins write their Messages without a Draft.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite (ADR-0005).
AI_MODEL=
# Direct connection string of a Neon test branch or a separate test database. The tests wipe it.
TEST_DATABASE_URL=

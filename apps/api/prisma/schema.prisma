generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Author {
  id           String   @id @default(uuid())
  // The sample data's author ID, such as AUTH001.
  externalRef  String   @unique @map("external_ref")
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String
  city         String
  joinedDate   DateTime @map("joined_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("authors")
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}
